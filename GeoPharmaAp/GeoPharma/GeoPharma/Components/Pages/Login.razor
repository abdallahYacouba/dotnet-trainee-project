@page "/"
@layout LoginLayout
@inject NavigationManager Navigation


<div class="login-page" id="loginPage">

    <!-- Left panel: branding -->
    <div class="login-left">
        <div class="login-brand">
            <div class="login-logo"><i class="bi bi-capsule-fill"></i></div>
            <span class="login-brand-name">GeoPharma</span>
        </div>
        <div class="login-hero">
            <h2 class="login-hero-title">Gérez votre réseau de pharmacies</h2>
            <p class="login-hero-sub">Plateforme centralisée pour la gestion des pharmacies, et médecins à travers tout le Niger.</p>
            <div class="login-features">
                <div class="login-feature"><i class="bi bi-hospital-fill"></i> 48 pharmacies connectées</div>
                <div class="login-feature"><i class="bi bi-people-fill"></i> 24 médecins enregistrés</div>
                <div class="login-feature"><i class="bi bi-shield-check"></i> Données sécurisées et chiffrées</div>
            </div>
        </div>
        <div class="login-left-footer">
            © 2026 GeoPharma Niger — Ministère de la Santé Publique
        </div>
    </div>

    <!-- Right panel: form -->
    <div class="login-right">
        <div class="login-card">

            <!-- Tabs: Connexion / SSO -->
            <div class="login-tabs">
                <button class="login-tab active" id="tabLogin" onclick="switchLoginTab('login')">
                    <i class="bi bi-lock-fill"></i> Connexion
                </button>
                <button class="login-tab" id="tabSSO" onclick="switchLoginTab('sso')">
                    <i class="bi bi-building-fill"></i> Single Sign-On
                </button>
            </div>

            <!-- ── Login form ── -->
            <div id="panelLogin">
                <h1 class="login-title">Bienvenue</h1>
                <p class="login-subtitle">Connectez-vous à votre espace GeoPharma</p>

                <form id="loginForm" onsubmit="doLogin(event)" novalidate>
                    <div class="lf-field">
                        <label class="lf-label" for="loginEmail">Adresse email</label>
                        <div class="lf-input-wrap">
                            <i class="bi bi-envelope lf-icon"></i>
                            <input type="email" id="loginEmail" class="lf-input" placeholder="vous@pharmanet.ne" required autocomplete="email" />
                        </div>
                        <span class="lf-error" id="emailErr"></span>
                    </div>

                    <div class="lf-field">
                        <label class="lf-label" for="loginPwd">
                            Mot de passe
                            <a href="#" class="lf-forgot" onclick="showForgot(event)">Mot de passe oublié ?</a>
                        </label>
                        <div class="lf-input-wrap">
                            <i class="bi bi-lock lf-icon"></i>
                            <input type="password" id="loginPwd" class="lf-input" placeholder="••••••••" required autocomplete="current-password" />
                            <button type="button" class="lf-eye" onclick="togglePwd('loginPwd', this)" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span class="lf-error" id="pwdErr"></span>
                    </div>

                    <div class="lf-remember">
                        <label class="lf-check-label">
                            <input type="checkbox" id="rememberMe" class="lf-check" /> Se souvenir de moi
                        </label>
                    </div>

                    <button type="submit" class="lf-submit" id="loginBtn" @onclick="GoToHome">
                        <span class="lf-submit-text">Se connecter</span>
                        <span class="lf-submit-loader" style="display:none;"><i class="bi bi-arrow-repeat spin"></i></span>
                    </button>
                </form>
            </div>

            <!-- ── SSO form ── -->
            <div id="panelSSO" style="display:none;">
                <h1 class="login-title">Single Sign-On</h1>
                <p class="login-subtitle">Connectez-vous via votre fournisseur d'identité</p>

                <div class="sso-providers">
                    <button class="sso-provider-btn" onclick="doSSO('Microsoft')">
                        <svg width="20" height="20" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="1" width="9" height="9" fill="#F25022" /><rect x="11" y="1" width="9" height="9" fill="#7FBA00" /><rect x="1" y="11" width="9" height="9" fill="#00A4EF" /><rect x="11" y="11" width="9" height="9" fill="#FFB900" /></svg>
                        Continuer avec Microsoft
                    </button>
                    <button class="sso-provider-btn" onclick="doSSO('Google')">
                        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" /><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" /><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" /><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" /></svg>
                        Continuer avec Google
                    </button>
                    <button class="sso-provider-btn" onclick="doSSO('SAML')">
                        <i class="bi bi-shield-fill-check" style="color:var(--blue);font-size:18px;"></i>
                        Connexion SAML / LDAP
                    </button>
                </div>

                <div class="lf-divider"><span>ou saisir le domaine</span></div>

                <div class="lf-field">
                    <label class="lf-label" for="ssoDomain">Domaine de l'organisation</label>
                    <div class="lf-input-wrap">
                        <i class="bi bi-globe lf-icon"></i>
                        <input type="text" id="ssoDomain" class="lf-input" placeholder="pharmanet.ne" />
                    </div>
                </div>
                <button type="button" class="lf-submit" onclick="doSSO('Domain')">
                    <span>Continuer</span>
                </button>

                <div class="text-center mt-3">
                    <button type="button" class="lf-back" onclick="switchLoginTab('login')">
                        <i class="bi bi-arrow-left"></i> Retour à la connexion
                    </button>
                </div>
            </div>

            <!-- ── Forgot password ── -->
            <div id="panelForgot" style="display:none;">
                <h1 class="login-title">Mot de passe oublié</h1>
                <p class="login-subtitle">Saisissez votre email pour recevoir un lien de réinitialisation</p>
                <div class="lf-field">
                    <label class="lf-label" for="forgotEmail">Adresse email</label>
                    <div class="lf-input-wrap">
                        <i class="bi bi-envelope lf-icon"></i>
                        <input type="email" id="forgotEmail" class="lf-input" placeholder="vous@pharmanet.ne" />
                    </div>
                </div>
                <button type="button" class="lf-submit" onclick="doForgot()">
                    Envoyer le lien
                </button>
                <div class="text-center mt-3">
                    <button type="button" class="lf-back" onclick="switchLoginTab('login')">
                        <i class="bi bi-arrow-left"></i> Retour à la connexion
                    </button>
                </div>
            </div>

            <!-- Footer -->
            <div class="login-card-footer">
                <span>Besoin d'aide ?</span>
                <a href="mailto:support@geopharma.ne">support@geopharma.ne</a>
            </div>

        </div>
    </div>

</div>



@code {
    private void GoToHome(MouseEventArgs args)
    {
        Navigation.NavigateTo("/home");
    }
}
