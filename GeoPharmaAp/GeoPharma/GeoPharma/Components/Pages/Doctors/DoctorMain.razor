  </div>




  <!-- Empty state -->
  <div id="docEmpty" class="empty-state" style="display:none;">
    <i class="bi bi-people" style="font-size:2.5rem;color:var(--border-input);"></i>
    <div style="font-size:var(--fs-base);font-weight:700;color:var(--text-dark);margin-top:8px;">Aucun médecin trouvé</div>
    <div style="font-size:var(--fs-sm);color:var(--text-soft);">Modifiez vos filtres ou ajoutez un nouveau médecin.</div>
  </div>



