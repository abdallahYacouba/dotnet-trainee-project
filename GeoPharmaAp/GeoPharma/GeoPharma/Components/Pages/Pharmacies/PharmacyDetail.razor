@page "/pharmacy-detail"

<!-- Back -->
<div class="mb-4">
    <a href="#" class="back-link"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
</div>

<!-- Profile Header -->
<div class="profile-header mb-4">
    <div class="profile-banner"></div>
    <div class="profile-header-body">
        <div class="profile-avatar-wrap">
            <div class="profile-avatar" style="background:linear-gradient(135deg,var(--blue),#0fa366);">
                <i class="bi bi-hospital-fill" style="font-size:var(--fs-xl);color:#fff;"></i>
            </div>
        </div>
        <div class="profile-meta">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <h1 class="profile-name">Pharmacie Centrale Niamey</h1>
                <span class="profile-role-badge"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Active</span>
            </div>
            <div class="d-flex align-items-center gap-4 mt-2 flex-wrap">
                <span class="profile-sub"><i class="bi bi-geo-alt"></i> District Niamey I</span>
                <span class="profile-sub"><i class="bi bi-calendar3"></i> Ouverte le 14 mars 2010</span>
                <span class="profile-sub"><i class="bi bi-hash"></i> PHM-001</span>
            </div>
        </div>
        <div class="profile-actions ms-auto">
            <button class="profile-btn-edit"><i class="bi bi-pencil"></i> Modifier</button>
            <button class="profile-btn-del"><i class="bi bi-trash3"></i></button>
        </div>
    </div>
</div>

