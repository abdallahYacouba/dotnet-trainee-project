
@if(Url != "") 
{    
    <a href="@Url" class="ph-social-link @LogoColor" title="@Label"><i class="@Logo"></i></a>
}


@code {
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public string? Logo { get; set; }
    [Parameter] public string? LogoColor { get; set; }
    [Parameter] public string? Label { get; set; }
}

<style>    
.ph-social-link {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1.5px solid var(--border-input);
    background: var(--surface);
    color: var(--text-soft);
    text-decoration: none;
    font-size: 13px;
    transition: all .15s;
    flex-shrink: 0;
}

.ph-social-link:hover { border-color: var(--text-soft); color: var(--text-dark); background: var(--bg-hover); }
.ph-social-link.linkedin:hover { background: #0a66c2; border-color: #0a66c2;color: #fff; }
.ph-social-link.instagram:hover { background: linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);border-color: #e1306c;color: #fff;}
.ph-social-link.x:hover { background: #000; border-color: #000; color: #fff; }
.ph-social-link.facebook:hover {background: #1877f2; border-color: #1877f2; color: #fff; }
.ph-social-link.youtube:hover { background: #ff0000; border-color: #ff0000;color: #fff; }

</style>
