             xmlns:local="clr-namespace:NextDevWPF.UI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Brush/ColorBrush.xaml"/>
                <ResourceDictionary Source="Resources/LookUp/IconDataLookup.xaml"/>
