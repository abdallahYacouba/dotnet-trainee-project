@page "/pharmacy"
@using GeoPharma.AppData
@using GeoPharma.Components.Shared
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IDbContextFactory<AppDbContext> _contextFactory


<h1 class="page-title">Catalogue des Pharmacies</h1>

<!-- Search + View Toggle -->
<div class="search-view-row">
    <div class="app-search-wrap">
        <i class="bi bi-search asi"></i>
        <input type="text" class="app-search" placeholder="Rechercher par DCI, nom commercial, fournisseur…" />
    </div>
    <div class="view-toggle-group">
        <button class="view-btn active" id="btnGrid" onclick="setView('grid')" title="Grid view">
            <i class="bi bi-grid-3x3-gap-fill"></i><span class="view-btn-label">Grille</span>
        </button>
        <button class="view-btn" id="btnList" onclick="setView('list')" title="List view">
            <i class="bi bi-list-ul"></i><span class="view-btn-label">Liste</span>
        </button>
    </div>
</div>

<!-- Filters -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Tous</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Niamey</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Agadez</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Diffa</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Dosso</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Maradi</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Tahoua</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Tillabéri</button>
    <button class="filter-btn"><i class="bi bi-geo-alt"></i> Zinder</button>
</div>

<!-- Sort bar -->
<div class="sort-bar">
    <span class="count-text">@Pharmacies!.Count pharmacies</span>
</div>

<!-- Cards -->
<div class="row g-3" id="cardsContainer">
    @if (Pharmacies is not null)
    {
        @foreach (var ph in Pharmacies)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="ph-card">
                    <div class="ph-card-top">
                        <div class="ph-avatar" style="background:linear-gradient(135deg,#0a7c4e,#0fa366);">PC</div>
                        <div class="ph-title">
                            <div class="ph-name">Pharmacie @ph.Name</div>
                            <div class="ph-district"><i class="bi bi-geo-alt"></i> @ph.Address!.District</div>
                        </div>
                        <span class="ph-status-badge @(ph.Status ? "active" : "inactive")">
                            @if(ph.Status)
                            {
                                <span>Active</span>
                            }
                            else
                            {
                                <span>Inactive</span>
                            }
                        </span>
                    </div>
                    <div class="ph-card-body">
                        <div class="ph-row"><i class="bi bi-telephone"></i> @ph.Address.PhoneNumber1</div>
                        <div class="ph-row"><i class="bi bi-envelope"></i> @ph.Address.Email</div>
                        <div class="ph-row"><i class="bi bi-calendar3"></i> Ouverte le @ph.CreateAt</div>
                        <div class="ph-row"><i class="bi bi-person-badge"></i> Dr. @ph.Doctor!.FullName</div>
                        <div class="ph-row"><i class="bi bi-pin-map"></i> @ph.Region!.Name, @ph.Municipality!.Name</div>
                        <div class="ph-row"><i class="bi bi-globe"></i> @ph.Address.WebSiteUrl</div>
                        <div class="ph-social">
                            <SocialLink Url="@ph.Address.LinkedInUrl" Logo="bi bi-linkedin" LogoColor="linkedin" Label="LinkedIn"/>
                            <SocialLink Url="@ph.Address.InstagramUrl" Logo="bi bi-instagram" LogoColor="instagram" Label="Instagram" />
                            <SocialLink Url="@ph.Address.XUrl" Logo="bi bi-twitter-x" LogoColor="x" Label="X (Twitter)"/>
                            <SocialLink Url="@ph.Address.FacebookUrl" Logo="bi bi-facebook" LogoColor="facebook" Label="Facebook"/>
                            <SocialLink Url="@ph.Address.YoutubeUrl" Logo="bi bi-youtube" LogoColor="youtube" Label="YouTube" />
                            @* <a href="@ph.Address.LinkedInUrl" class="ph-social-link linkedin" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="@ph.Address.InstagramUrl" class="ph-social-link instagram" title="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="@ph.Address.XUrl" class="ph-social-link x" title="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
                            <a href="@ph.Address.FacebookUrl" class="ph-social-link facebook" title="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="@ph.Address.YoutubeUrl" class="ph-social-link youtube" title="YouTube"><i class="bi bi-youtube"></i></a> *@
                        </div>
                    </div>
                    <div class="ph-card-footer">
                        <span class="ph-region-pill">Niamey</span>
                        <div class="ph-act-group">
                            <button class="ph-act" @onclick="NavToDetailHandler" title="Voir"><i class="bi bi-eye"></i></button>
                            <button class="ph-act" title="Modifier"><i class="bi bi-pencil"></i></button>
                            <button class="ph-act danger" title="Supprimer"><i class="bi bi-trash3"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        }     
    }
