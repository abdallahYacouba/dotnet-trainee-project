@code {
    private List<GeoPharma.Model.Entities.Pharmacy>? Pharmacies { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        using var context = _contextFactory.CreateDbContext();
        Pharmacies = await context.Pharmacies
            .Include(r => r.Region)
            .Include(m => m.Municipality)
            .Include(d => d.Doctor)
            .ToListAsync();
    }

    private void NavToDetailHandler(EventArgs args)
    {
        Navigation.NavigateTo("/pharmacy-detail");
    }
}
